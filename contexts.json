        { "tagId": "aux", "label": "Aux", "text": "đã", "phonetic": "/da/", "explanation": "Trợ từ chỉ thì quá khứ. Tiếng Việt không biến đổi động từ mà dùng từ chỉ thời gian đứng trước." },
        { "tagId": "verb", "label": "V", "text": "ăn", "phonetic": "/an/", "explanation": "Động từ chính, giữ nguyên thể." },
        { "tagId": "obj", "label": "O", "text": "một quả táo", "phonetic": "/mot qua tao/", "explanation": "Tân ngữ trực tiếp." },
        { "tagId": "time", "label": "Time", "text": "hôm qua", "phonetic": "/hom qua/", "explanation": "Trạng ngữ chỉ thời gian, đứng cuối hoặc đầu câu." }
      ],
      "zh": [
        { "tagId": "subj", "label": "S", "text": "我", "phonetic": "wǒ", "explanation": "Chủ ngữ." },
        { "tagId": "time", "label": "Time", "text": "昨天", "phonetic": "zuó tiān", "explanation": "Từ chỉ thời gian. Tiếng Trung thường đặt Thời gian NGAY SAU chủ ngữ (S - Time - V - O)." },
        { "tagId": "verb", "label": "V", "text": "吃", "phonetic": "chī", "explanation": "Động từ chính." },
        { "tagId": "aux", "label": "Aux", "text": "了", "phonetic": "le", "explanation": "Trợ từ động thái '了' đứng sau động từ biểu thị hành động đã hoàn thành." },
        { "tagId": "obj", "label": "O", "text": "一个苹果", "phonetic": "yí ge píng guǒ", "explanation": "Tân ngữ (Số từ + Lượng từ + Danh từ)." }
      ],
      "ja": [
        { "tagId": "subj", "label": "S", "text": "私は", "phonetic": "watashi wa", "explanation": "Chủ ngữ + Trợ từ chủ đề 'wa'." },
        { "tagId": "time", "label": "Time", "text": "昨日", "phonetic": "kinō", "explanation": "Từ chỉ thời gian." },
        { "tagId": "obj", "label": "O", "text": "りんごを", "phonetic": "ringo o", "explanation": "Tân ngữ + Trợ từ tân ngữ 'o'. Đặt TRƯỚC động từ." },
        { "tagId": "verb", "label": "V", "text": "食べました", "phonetic": "tabemashita", "explanation": "Động từ chia ở thể quá khứ lịch sự. Tiếng Nhật ĐỘNG TỪ LUÔN ĐỨNG CUỐI CÂU (SOV)." }
      ]
    }
  },
