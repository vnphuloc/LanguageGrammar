    "languages": {
      "en": [
        { "tagId": "subj", "label": "S", "text": "I", "phonetic": "/aɪ/", "explanation": "Chủ ngữ (Đại từ nhân xưng ngôi thứ nhất)." },
        { "tagId": "verb", "label": "V", "text": "ate", "phonetic": "/eɪt/", "explanation": "Động từ 'eat' chia ở quá khứ bất quy tắc. Tiếng Anh biến đổi hình thái từ thay vì thêm phụ từ." },
        { "tagId": "obj", "label": "O", "text": "an apple", "phonetic": "/ən ˈæp.əl/", "explanation": "Tân ngữ trực tiếp, theo ngay sau động từ (SVO)." },
